<?xml version="1.0" encoding="utf-8"?>
<!-- AnChSa, 2026-11-05: native MSVC/Windows XDP integration. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <KickCATXdpRoot>$(MSBuildThisFileDirectory)</KickCATXdpRoot>
    <KickCATXdpSuffix></KickCATXdpSuffix>
    <KickCATXdpSuffix Condition="'$(Configuration)' == 'Debug'">d</KickCATXdpSuffix>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(KickCATXdpRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_DECLARE_NONSTDC_NAMES=0;NOMINMAX;WIN32_LEAN_AND_MEAN;KICKCAT_WINDOWS_XDP_ENABLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(KickCATXdpRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>KickCAT-XDP$(KickCATXdpSuffix).lib;@KICKCAT_XDP_SYSTEM_LIBS@%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CopyKickCATXdpRuntime" AfterTargets="Build"
          Condition="Exists('$(KickCATXdpRoot)bin\KickCAT-XDP$(KickCATXdpSuffix).dll')">
    <Copy SourceFiles="$(KickCATXdpRoot)bin\KickCAT-XDP$(KickCATXdpSuffix).dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
